{
  "manifest_version": 3,
  "name": "BookMarker",
  "version": "1.0",
  "description": "Tracks your read position and lets you resume exactly where you left off.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Resume Reading"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
